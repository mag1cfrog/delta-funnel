#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: capture-workload [--mode short|streaming|deep-system] [--sample-hz 100|1000] --output TRACE -- COMMAND [ARG...]

Record one diagnostics-enabled Python workload, check the saved trace, and
generate a sibling ranked HTML report.
The default mode is short. Short mode defaults to 1000 Hz; other modes default
to 100 Hz.
EOF
}

mode=short
sample_hz=
capture_path=
while (( $# > 0 )); do
  case $1 in
    --help|-h)
      usage
      exit 0
      ;;
    --mode)
      if (( $# < 2 )); then
        usage >&2
        exit 64
      fi
      mode=${2:-}
      shift 2
      ;;
    --sample-hz)
      if (( $# < 2 )); then
        usage >&2
        exit 64
      fi
      case ${2:-} in
        100|1000)
          sample_hz=$2
          ;;
        *)
          printf 'capture-workload: unsupported sample frequency: %s\n' \
            "${2:-}" >&2
          exit 64
          ;;
      esac
      shift 2
      ;;
    --output)
      if (( $# < 2 )); then
        usage >&2
        exit 64
      fi
      capture_path=${2:-}
      shift 2
      ;;
    --)
      shift
      break
      ;;
    *)
      printf 'capture-workload: unknown argument: %s\n' "$1" >&2
      usage >&2
      exit 64
      ;;
  esac
done

if [[ -z $capture_path || $# == 0 ]]; then
  usage >&2
  exit 64
fi

script_dir=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
case $mode in
  short)
    packaged_capture_config=$script_dir/delta-funnel-standard.pbtx
    default_sample_hz=1000
    configured_file_cap_bytes=
    ;;
  streaming)
    packaged_capture_config=$script_dir/delta-funnel-standard-streaming.pbtx
    default_sample_hz=100
    configured_file_cap_bytes=536870912
    ;;
  deep-system)
    packaged_capture_config=$script_dir/delta-funnel-deep-system.pbtx
    default_sample_hz=100
    configured_file_cap_bytes=
    ;;
  *)
    printf 'capture-workload: unsupported mode: %s\n' "$mode" >&2
    exit 64
    ;;
esac
if [[ -z $sample_hz ]]; then
  sample_hz=$default_sample_hz
fi

if [[ ! -r $packaged_capture_config || ! -x $script_dir/capture-health ]]; then
  printf 'capture-workload: packaged Perfetto assets are incomplete\n' >&2
  exit 69
fi

tracebox=${TRACEBOX:-$script_dir/delta-funnel-tracebox}
trace_processor=${TRACE_PROCESSOR_SHELL:-trace_processor_shell}
perf=${PERF:-perf}
for executable in "$tracebox" "$trace_processor" "$perf" awk od setsid; do
  if ! command -v "$executable" >/dev/null 2>&1; then
    printf 'capture-workload: required command is unavailable: %s\n' \
      "$executable" >&2
    exit 127
  fi
done

if [[ $(uname -s) != Linux ]]; then
  printf 'capture-workload: Perfetto diagnostics require Linux\n' >&2
  exit 69
fi
if [[ $mode == deep-system ]]; then
  test -r /sys/kernel/tracing/events/sched/sched_switch/id &&
    test -w /sys/kernel/tracing/tracing_on || {
      printf 'capture-workload: deep-system mode requires tracefs access\n' >&2
      exit 77
    }
fi

capture_dir=$(dirname -- "$capture_path")
mkdir -p -- "$capture_dir"
if [[ ! -w $capture_dir ]]; then
  printf 'capture-workload: output directory is not writable: %s\n' \
    "$capture_dir" >&2
  exit 73
fi
if [[ -e $capture_path || -L $capture_path ]]; then
  printf 'capture-workload: output already exists: %s\n' "$capture_path" >&2
  exit 73
fi
case $capture_path in
  *.pftrace)
    report_path=${capture_path%.pftrace}.profile.html
    ;;
  *)
    report_path=$capture_path.profile.html
    ;;
esac
if [[ -e $report_path || -L $report_path ]]; then
  printf 'capture-workload: report output already exists: %s\n' "$report_path" >&2
  exit 73
fi

target=$1
if [[ $target != */* ]]; then
  target=$(command -v "$target") || {
    printf 'capture-workload: command is unavailable: %s\n' "$1" >&2
    exit 127
  }
fi
if [[ ! -x $target ]]; then
  printf 'capture-workload: command is not executable: %s\n' "$target" >&2
  exit 126
fi
shift

target_dir=$(CDPATH= cd -- "$(dirname -- "$target")" && pwd -P)
report_cli=$target_dir/delta-funnel-perfetto
if [[ ! -x $report_cli ]]; then
  report_cli=$(command -v delta-funnel-perfetto) || {
    printf '%s\n' \
      'capture-workload: required command is unavailable: delta-funnel-perfetto' >&2
    exit 127
  }
fi
if ! "$report_cli" report --help >/dev/null; then
  printf '%s\n' \
    'capture-workload: ranked report command is unavailable' >&2
  exit 69
fi
report_cli_dir=$(CDPATH= cd -- "$(dirname -- "$report_cli")" && pwd -P)
gate_python=
for candidate in "$report_cli_dir/python3" "$report_cli_dir/python"; do
  if [[ -x $candidate ]]; then
    gate_python=$candidate
    break
  fi
done
if [[ -z $gate_python ]]; then
  IFS= read -r report_cli_shebang <"$report_cli" || true
  case $report_cli_shebang in
    '#!'/*)
      candidate=${report_cli_shebang#\#!}
      if [[ $candidate != *' '* && -x $candidate ]]; then
        gate_python=$candidate
      fi
      ;;
  esac
fi
if [[ -z $gate_python ]]; then
  printf '%s\n' \
    'capture-workload: diagnostics Python interpreter is unavailable' >&2
  exit 127
fi
runtime_dir=$(mktemp -d /tmp/delta-funnel-perfetto.XXXXXX)
runtime_dir=$(CDPATH= cd -- "$runtime_dir" && pwd -P)
tracebox_ready_file=$runtime_dir/tracebox-ready
tracebox_gate_socket=$runtime_dir/tracebox-gate.sock
tracebox_gate_ready_file=$runtime_dir/tracebox-gate-ready
tracebox_workload_pid_file=$runtime_dir/workload-pid
tracebox_gate_connected_file=$runtime_dir/tracebox-gate-connected
tracebox_activated_file=$runtime_dir/tracebox-activated
trace_pid=
tracebox_target_pid=
workload_pid=
diagnostics_pid=
diagnostics_stage=
interruption_status=
interruption_signal=
status_emitted=0
workload_status=
health_status=125
report_status=125
report_output=
health_output_file=$runtime_dir/capture-health.out
stop_grace_polls=100
tracebox_stop_grace_polls=1000

emit_status() {
  local workload_status=$1
  local tracebox_status=$2
  local health_status=$3
  local report_status=$4
  local report_output=${5:-}

  printf 'workload_status=%s tracebox_status=%s health_status=%s report_status=%s sample_hz=%s trace=%q' \
    "$workload_status" "$tracebox_status" "$health_status" "$report_status" \
    "$sample_hz" "$capture_path"
  if [[ -n $report_output ]]; then
    printf ' report=%q' "$report_output"
  fi
  printf '\n'
  status_emitted=1
}

stop_tracebox() {
  if [[ -z $trace_pid ]]; then
    return 0
  fi
  if stop_process_group \
    "$trace_pid" TERM "$tracebox_stop_grace_polls" leader; then
    tracebox_status=0
  else
    tracebox_status=$?
  fi
  trace_pid=
}

process_finished() {
  local pid=$1
  local process_stat
  if [[ ! -r /proc/$pid/stat ]]; then
    return 0
  fi
  process_stat=$(<"/proc/$pid/stat") || return 0
  process_stat=${process_stat##*) }
  [[ ${process_stat%% *} == Z ]]
}

stop_process_group() {
  local pid=$1
  local signal=$2
  local grace_polls=${3:-$stop_grace_polls}
  local initial_signal_scope=${4:-group}
  local status=0
  local waited=0
  local poll

  if [[ $initial_signal_scope == group ]]; then
    kill "-$signal" -- "-$pid" 2>/dev/null ||
      kill "-$signal" "$pid" 2>/dev/null ||
      true
  else
    kill "-$signal" "$pid" 2>/dev/null || true
  fi
  for (( poll = 0; poll < grace_polls; poll++ )); do
    if (( waited == 0 )) && process_finished "$pid"; then
      if wait "$pid" 2>/dev/null; then
        status=0
      else
        status=$?
      fi
      waited=1
    fi
    if (( waited == 1 )) && ! kill -0 -- "-$pid" 2>/dev/null; then
      return "$status"
    fi
    sleep 0.01
  done

  kill -KILL -- "-$pid" 2>/dev/null ||
    kill -KILL "$pid" 2>/dev/null ||
    true
  if (( waited == 0 )); then
    if wait "$pid" 2>/dev/null; then
      status=0
    else
      status=$?
    fi
  fi
  return "$status"
}

stop_workload() {
  if [[ -z $workload_pid ]]; then
    return 0
  fi
  local signal=${interruption_signal:-TERM}
  if stop_process_group "$workload_pid" "$signal"; then
    workload_status=0
  else
    workload_status=$?
  fi
  workload_pid=
}

workload_stopped_by_wrapper() {
  [[ $workload_status == 137 || $workload_status == 143 ]]
}

finish_health() {
  local status=$1
  if (( status != 0 )); then
    health_status=$status
    return 0
  fi

  health_output=$(<"$health_output_file")
  printf '%s\n' "$health_output"
  health_row=$(sed -n '$p' <<<"$health_output")
  capture_complete=${health_row%%,*}
  if [[ $capture_complete == 1 ]]; then
    health_status=0
  else
    health_status=65
  fi
}

finish_report() {
  report_status=$1
  if (( report_status == 0 )); then
    if [[ -f $report_path && ! -L $report_path && -r $report_path &&
          -s $report_path ]]; then
      report_output=$report_path
    else
      report_status=73
      printf '%s\n' \
        'capture-workload: report command produced no complete report' >&2
    fi
  fi
}

stop_diagnostics() {
  if [[ -z $diagnostics_pid ]]; then
    return 0
  fi
  local signal=${interruption_signal:-TERM}
  local status
  if stop_process_group "$diagnostics_pid" "$signal"; then
    status=0
  else
    status=$?
  fi
  case $diagnostics_stage in
    health) finish_health "$status" ;;
    report) finish_report "$status" ;;
  esac
  diagnostics_pid=
  diagnostics_stage=
}

warn_if_completed_workload() {
  if [[ $workload_status == 0 &&
        (${tracebox_status:-125} != 0 ||
         $health_status != 0 ||
         $report_status != 0) ]]; then
    printf '%s\n' \
      'capture-workload: workload succeeded; do not retry it because diagnostics failed' >&2
  fi
}

cleanup() {
  local status=$?
  trap - EXIT INT TERM HUP
  stop_workload
  stop_diagnostics
  stop_tracebox
  if [[ $status_emitted == 0 ]]; then
    if [[ -z $workload_status ]]; then
      workload_status=${interruption_status:-125}
    fi
    emit_status "$workload_status" "${tracebox_status:-125}" \
      "$health_status" "$report_status" "$report_output"
    warn_if_completed_workload
  fi
  rm -rf -- "$runtime_dir" || true
  exit "$status"
}
trap cleanup EXIT
trap 'interruption_status=130; interruption_signal=INT; exit 130' INT
trap 'interruption_status=143; interruption_signal=TERM; exit 143' TERM
trap 'interruption_status=129; interruption_signal=HUP; exit 129' HUP

capture_config_template=$runtime_dir/capture-template.pbtx
capture_config=$runtime_dir/capture.pbtx
if ! awk -v sample_hz="$sample_hz" '
  BEGIN {
    read_period_ms = sample_hz == 1000 ? 10 : 100
    ring_buffer_pages = sample_hz == 1000 ? 512 : 256
  }
  /^[[:space:]]*frequency:[[:space:]]*[0-9]+[[:space:]]*$/ {
    frequency_count++
    if (frequency_count == 1) {
      sub(/[0-9]+/, sample_hz)
    }
  }
  /^[[:space:]]*ring_buffer_read_period_ms:[[:space:]]*[0-9]+[[:space:]]*$/ {
    read_period_count++
    if (read_period_count == 1) {
      sub(/[0-9]+/, read_period_ms)
    }
  }
  /^[[:space:]]*ring_buffer_pages:[[:space:]]*[0-9]+[[:space:]]*$/ {
    ring_buffer_pages_count++
    if (ring_buffer_pages_count == 1) {
      sub(/[0-9]+/, ring_buffer_pages)
    }
  }
  /^[[:space:]]*target_cmdline:/ {
    target_count++
  }
  /^[[:space:]]*target_cmdline:[[:space:]]*"delta-funnel-perfetto-preview"[[:space:]]*$/ {
    canonical_target_count++
  }
  /^[[:space:]]*target_pid:/ {
    target_pid_count++
  }
  { print }
  END {
    if (frequency_count != 1 || read_period_count != 1 ||
        ring_buffer_pages_count != 1 || target_count != 1 ||
        canonical_target_count != 1 || target_pid_count != 0) exit 1
  }
' "$packaged_capture_config" >"$capture_config_template"; then
  printf 'capture-workload: failed to prepare Perfetto sampling config: %s\n' \
    "$packaged_capture_config" >&2
  exit 69
fi

if "$tracebox" --system-sockets --query >/dev/null; then
  :
else
  tracebox_status=$?
  printf 'capture-workload: Perfetto system service is unavailable\n' >&2
  exit 69
fi
"$perf" stat --all-cpus --event cpu-clock -- sleep 0.1 >/dev/null 2>&1 || {
  printf 'capture-workload: Linux performance events are unavailable\n' >&2
  exit 77
}

# The diagnostics interpreter owns this gate so its PID survives tracebox exec.
# READY is pre-commit; only the intended workload's RELEASE publishes activation.
tracebox_start_gate='import os
import socket
import struct
import sys
import time

def create_marker(path, contents=b""):
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    descriptor = os.open(path, flags, 0o600)
    with os.fdopen(descriptor, "wb") as marker:
        marker.write(contents)

def read_pid(path):
    deadline = time.monotonic() + 5
    while time.monotonic() < deadline:
        try:
            with open(path, "rb") as source:
                return int(source.read())
        except (FileNotFoundError, ValueError):
            time.sleep(0.01)
    raise SystemExit(70)

os.setsid()
server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
server.bind(sys.argv[1])
server.listen(1)
create_marker(sys.argv[2], str(os.getpid()).encode())
connection, _ = server.accept()
credentials = connection.getsockopt(
    socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i")
)
peer_pid, _, _ = struct.unpack("3i", credentials)
if peer_pid != read_pid(sys.argv[3]):
    raise SystemExit(70)
create_marker(sys.argv[4])
connection.sendall(b"R")
if connection.recv(1) != b"\n":
    raise SystemExit(70)
create_marker(sys.argv[5])

read_descriptor, write_descriptor = os.pipe()
if os.fork() == 0:
    server.close()
    os.close(write_descriptor)
    readiness = os.read(read_descriptor, 1) or b"\xff"
    os.close(read_descriptor)
    readiness_descriptor = None
    try:
        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
        readiness_descriptor = os.open(sys.argv[6], flags, 0o600)
    except OSError:
        readiness = b"\xff"
    try:
        connection.sendall(readiness)
    except OSError:
        pass
    connection.close()
    if readiness_descriptor is not None:
        with os.fdopen(readiness_descriptor, "wb") as marker:
            marker.write(readiness)
    os._exit(0)

os.close(read_descriptor)
connection.close()
server.close()
if write_descriptor != 3:
    os.dup2(write_descriptor, 3)
    os.close(write_descriptor)
os.set_inheritable(3, True)
os.execvp(sys.argv[7], sys.argv[7:])'
"$gate_python" -I -S -c "$tracebox_start_gate" \
  "$tracebox_gate_socket" \
  "$tracebox_gate_ready_file" \
  "$tracebox_workload_pid_file" \
  "$tracebox_gate_connected_file" \
  "$tracebox_activated_file" \
  "$tracebox_ready_file" \
  "$tracebox" \
  --txt --system-sockets --no-clobber \
  --notify-fd 3 \
  --config "$capture_config" \
  --out "$capture_path" &
trace_pid=$!

for (( poll = 0; poll < 1500; poll++ )); do
  if [[ -s $tracebox_gate_ready_file ]] || process_finished "$trace_pid"; then
    break
  fi
  sleep 0.01
done
if [[ -s $tracebox_gate_ready_file ]]; then
  tracebox_target_pid=$(<"$tracebox_gate_ready_file")
fi
if [[ ! $tracebox_target_pid =~ ^[1-9][0-9]*$ ]] ||
   (( tracebox_target_pid > 2147483647 )) ||
   [[ $tracebox_target_pid != "$trace_pid" ]]; then
  stop_tracebox
  emit_status 125 "${tracebox_status:-125}" 125 125
  printf '%s\n' \
    'capture-workload: tracebox start gate did not become ready' >&2
  exit 69
fi

(
  export DELTA_FUNNEL_PERFETTO_TRACEBOX_PID=$tracebox_target_pid
  export DELTA_FUNNEL_PERFETTO_TRACEBOX_GATE_SOCKET=$tracebox_gate_socket
  export DELTA_FUNNEL_PERFETTO_WORKLOAD_PID=$BASHPID
  exec setsid --wait "$target" "$@"
) &
workload_pid=$!
if ! awk -v target_pid="$workload_pid" '
  /^[[:space:]]*target_cmdline:/ {
    target_count++
  }
  /^[[:space:]]*target_cmdline:[[:space:]]*"delta-funnel-perfetto-preview"[[:space:]]*$/ {
    replacement_count++
    indent = $0
    sub(/[^[:space:]].*$/, "", indent)
    printf "%starget_pid: %s\n", indent, target_pid
    next
  }
  { print }
  END {
    if (target_count != 1 || replacement_count != 1) exit 1
  }
' "$capture_config_template" >"$capture_config"; then
  workload_finished=0
  if process_finished "$workload_pid"; then
    workload_finished=1
  fi
  stop_workload
  stop_tracebox
  emit_status "${workload_status:-125}" "${tracebox_status:-125}" 125 125
  warn_if_completed_workload
  printf '%s\n' \
    'capture-workload: failed to scope Perfetto sampling to the workload' >&2
  if (( workload_finished == 1 )) || ! workload_stopped_by_wrapper; then
    exit "$workload_status"
  fi
  exit 69
fi
printf '%s' "$workload_pid" >"$tracebox_workload_pid_file"

while [[ ! -e $tracebox_activated_file ]]; do
  if process_finished "$workload_pid"; then
    # A connected gate may still have the committed release byte queued after
    # an unusually fast workload exit. Let it publish activation or exit.
    if [[ -e $tracebox_gate_connected_file ]]; then
      for (( poll = 0; poll < 1500; poll++ )); do
        if [[ -e $tracebox_activated_file ]] ||
           process_finished "$trace_pid"; then
          break
        fi
        sleep 0.01
      done
      if [[ -e $tracebox_activated_file ]]; then
        break
      fi
    fi
    stop_workload
    stop_tracebox
    emit_status "$workload_status" "${tracebox_status:-125}" 125 125
    warn_if_completed_workload
    printf '%s\n' \
      'capture-workload: workload exited before activating Perfetto diagnostics' >&2
    exit "$workload_status"
  fi
  if process_finished "$trace_pid"; then
    workload_finished=0
    if process_finished "$workload_pid"; then
      workload_finished=1
    fi
    stop_workload
    stop_tracebox
    emit_status "${workload_status:-125}" "${tracebox_status:-125}" 125 125
    warn_if_completed_workload
    printf '%s\n' \
      'capture-workload: tracebox start gate failed before activation' >&2
    if (( workload_finished == 1 )) || ! workload_stopped_by_wrapper; then
      exit "$workload_status"
    fi
    exit 69
  fi
  sleep 0.01
done

# Producer initialization and scoped ptrace authorization are complete here.
# Let the native 15-second managed-readiness deadline report first.
readiness=
for (( poll = 0; poll < 2000; poll++ )); do
  if [[ -s $tracebox_ready_file ]] || process_finished "$trace_pid"; then
    break
  fi
  sleep 0.01
done
if [[ -s $tracebox_ready_file ]]; then
  readiness=$(od -An -tu1 -N1 "$tracebox_ready_file" | tr -d '[:space:]')
fi
if [[ $readiness != 0 ]]; then
  workload_finished=0
  if process_finished "$workload_pid"; then
    workload_finished=1
  fi
  stop_workload
  stop_tracebox
  emit_status "${workload_status:-125}" "${tracebox_status:-125}" 125 125
  warn_if_completed_workload
  printf 'capture-workload: tracebox readiness failed: status=%s\n' \
    "${tracebox_status:-125}" >&2
  if (( workload_finished == 1 )) || ! workload_stopped_by_wrapper; then
    exit "$workload_status"
  fi
  exit 69
fi

if wait "$workload_pid"; then
  workload_status=0
else
  workload_status=$?
fi
workload_pid=
stop_tracebox

health_args=("$capture_path")
if [[ -n $configured_file_cap_bytes ]]; then
  health_args+=("$configured_file_cap_bytes")
fi
TRACE_PROCESSOR_SHELL=$trace_processor \
  setsid --wait "$script_dir/capture-health" "${health_args[@]}" \
  >"$health_output_file" &
diagnostics_pid=$!
diagnostics_stage=health
if wait "$diagnostics_pid"; then
  diagnostics_status=0
else
  diagnostics_status=$?
fi
finish_health "$diagnostics_status"
diagnostics_pid=
diagnostics_stage=

if (( diagnostics_status == 0 )); then
  setsid --wait "$report_cli" report "$capture_path" \
    --output "$report_path" --no-clobber &
  diagnostics_pid=$!
  diagnostics_stage=report
  if wait "$diagnostics_pid"; then
    diagnostics_status=0
  else
    diagnostics_status=$?
  fi
  finish_report "$diagnostics_status"
  diagnostics_pid=
  diagnostics_stage=
fi

emit_status "$workload_status" "${tracebox_status:-125}" "$health_status" \
  "$report_status" "$report_output"
warn_if_completed_workload
exit "$workload_status"
