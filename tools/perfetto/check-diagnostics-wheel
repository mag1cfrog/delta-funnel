        raise SystemExit("capture-workload did not preserve the workload failure")
    if (
        status["workload_status"] != "42"
        or status["tracebox_status"] != "0"
        or status["health_status"] != "0"
        or status["report_status"] != "0"
        or not trace.is_file()
