    def capture_artifacts(name, suffix=".pftrace"):
        trace = temp.joinpath("captures", f"{name}{suffix}")
        report = (
            trace.with_suffix(".profile.html")
            if suffix == ".pftrace"
            else Path(f"{trace}.profile.html")
        )
        return trace, report

    def capture_environment(**environment):
        return {
            **os.environ,
            "TRACEBOX": str(fake_tracebox),
            "PERF": str(fake_perf),
            "TRACE_PROCESSOR_SHELL": str(fake_trace_processor),
            "DELTA_FUNNEL_TEST_AGGREGATE": str(aggregate),
            **environment,
        }

    def run_capture(name, workload="pass", suffix=".pftrace", **environment):
        trace, report = capture_artifacts(name, suffix)
        result = subprocess.run(
            [
                capture,
                "--output",
                trace,
                "--",
                sys.executable,
                "-c",
                workload,
            ],
            env=capture_environment(**environment),
            cwd=temp,
            capture_output=True,
            text=True,
        )
        lines = result.stdout.splitlines()
        fields = (
            dict(field.split("=", 1) for field in shlex.split(lines[-1]))
            if lines
            else {}
        )
        return result, trace, report, fields

